<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AICompanion" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@color/eva_ink</item>
        <item name="android:navigationBarColor">@color/eva_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Brand-colored launch background: no white flash on cold start. -->
        <item name="android:windowBackground">@color/eva_ink</item>
    </style>
</resources>
